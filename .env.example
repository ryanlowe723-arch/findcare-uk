# ════════════════════════════════════════════════════════════
# FindCare UK — Environment Variables
# Copy to .env.local for local dev; add the same keys in the
# Vercel dashboard (Settings → Environment Variables) for prod.
# ════════════════════════════════════════════════════════════

# ── REQUIRED: Supabase (client-side) ─────────────────────────
# From: Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── OPTIONAL: Google reviews on practitioner profiles ────────
# From: Google Cloud Console → enable "Places API (New)" → create API key
# Server-side only (used by /api/google-reviews) — set in Vercel, NOT prefixed with VITE_
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# ════════════════════════════════════════════════════════════
# Supabase Edge Function secrets (set via CLI, not here):
#
#   supabase secrets set RESEND_API_KEY=re_xxx
#   supabase secrets set SITE_URL=https://your-domain.com
#   supabase secrets set EMAIL_FROM="FindCare UK <noreply@your-domain.com>"
#
# Then deploy the email function:
#   supabase functions deploy notify
# ════════════════════════════════════════════════════════════
